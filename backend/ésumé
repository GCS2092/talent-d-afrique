def normal_page(canvas, doc):
    canvas.saveState()
    canvas.setFillColor(GREY)
    canvas.setFont("Helvetica", 8)
    canvas.drawString(2*cm, 1.2*cm, "Talent d'Afrique — Rapport frontend mobile")
    canvas.drawRightString(A4[0]-2*cm, 1.2*cm, f"Page {doc.page}")
    canvas.setStrokeColor(LIGHT_BG)
    canvas.setLineWidth(1)
    canvas.line(2*cm, 1.5*cm, A4[0]-2*cm, 1.5*cm)
    canvas.restoreState()

def bullets(items):
    return ListFlowable(
        [ListItem(Paragraph(t, styles["BulletText"]), leftIndent=6, spaceAfter=5) for t in items],
        bulletType="bullet", start="•", leftIndent=14,
    )

def section_table(header, rows, col_widths):
    data = [[Paragraph(h, styles["TableHeader"]) for h in header]] + [
        [Paragraph(str(c), styles["TableCell"]) for c in row] for row in rows
    ]
    t = Table(data, colWidths=col_widths, repeatRows=1)
    t.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), PRIMARY),
        ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, LIGHT_BG]),
        ("GRID", (0, 0), (-1, -1), 0.5, colors.HexColor("#DDDED8")),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("LEFTPADDING", (0, 0), (-1, -1), 6),
        ("RIGHTPADDING", (0, 0), (-1, -1), 6),
        ("TOPPADDING", (0, 0), (-1, -1), 5),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
    ]))
    return t

